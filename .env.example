# Anthropic Claude API Key (Optional: for Tier 1 & Tier 2: claude-opus-4.8, claude-sonnet-4.6)
# If not configured, the backend automatically and silently skips to Gemini tiers
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (Required for Tier 3-5: gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini Model Fallback Chain (comma-separated, defaults to: gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Backend Base API URL (Configure in Vercel/Render frontend environment variables)
# Example: https://campussync-backend.onrender.com (leave empty for same-origin dev)
VITE_API_BASE_URL=
