# Gemini API Key (Configure in Render backend environment variables for production)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini Model Fallback Chain (comma-separated, defaults to: gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Backend Base API URL (Configure in Vercel/Render frontend environment variables)
# Example: https://campussync-backend.onrender.com (leave empty for same-origin dev)
VITE_API_BASE_URL=

